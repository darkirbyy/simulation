{% extends 'base.html.twig' %}

{% set title = 'A puzzle a day' %}

{% block main %}
  {{ form_start(form) }}
  <div class="d-flex justify-content-center align-items-end gap-2 mb-3">
    {{ form_row(form.day) }}
    {{ form_row(form.month) }}
    <div class="mb-3">
      <button type="submit" class="btn btn-outline-primary">Calculer</button>
    </div>
  </div>
  {{ form_end(form) }}

  {% if count is not null and board is not null %}
    {% if count >= 0 %}
      <p class="text-center fw-bold">
        {{ count }} solutions
        <a data-turbo="false" href="{{ app.request.requesturi }}" class="btn btn-sm btn-outline-secondary" aria-label="Relancer">
          <span aria-hidden="true" data-turbo="false" class="bi bi-arrow-repeat"></span>
        </a>
      </p>
    {% else %}
      <p class="text-center fw-bold text-danger">
        Erreur lors du calcul des solutions
      </p>
    {% endif %}
    <div class="text-center mx-auto app-apad-container">
      <div class="d-grid p-2 justify-content-center align-items-center app-apad-grid">
        {% for key, cell in board %}
          <div class="d-flex justify-content-center align-items-center app-apad-cell-{{ cell }}">
            {{ cell == 0 or cell == 9 ? key }}
            {# {{ cell == 0 or cell == 9 ? key : (cell < 10 ? cell) }} #}
          </div>
        {% endfor %}
      </div>
    </div>
  {% endif %}
{% endblock %}
