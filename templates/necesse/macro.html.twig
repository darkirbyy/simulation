{% macro display_seconds(seconds) %}
  {% set h = (seconds / 3600)|round(0, 'floor') %}
  {% set m = (seconds % 3600 / 60)|round(0, 'floor') %}
  {% set s = seconds % 60 %}
  {{- (h > 0 ? h ~ 'h ' : '') ~ (m > 0 ? m ~ 'min ' : '') ~ (s > 0 or (h == 0 and m == 0) ? s ~ 's ' : '') -}}
{% endmacro %}

{% macro display_microseconds(microseconds) %}
  {{- (microseconds|round(4)) ~ 's' -}}
{% endmacro %}

{% macro display_memory(memory) %}
  {{- ((memory / 1024 / 1024)|round(2)) ~ 'Mio' -}}
{% endmacro %}
