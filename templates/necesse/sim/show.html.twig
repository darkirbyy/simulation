{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}
{% import 'necesse/macro.html.twig' as mn %}

{% set title = "Détails d'une simulation" %}

{% block main %}
  {{ m.backlink(path('necesse_sim_index')) }}

  <h4 class="mt-2 mb-0">Paramètres</h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres globaux</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Monde</td>
        <td>
          {{ sim.world.label }}
          {{ m.show_button(path('necesse_world_show', { id: sim.world.id })) }}
        </td>
      </tr>
      <tr>
        <td>Temps</td>
        <td>{{ mn.display_seconds(sim.time) }}</td>
      </tr>
      <tr>
        <td>Graine</td>
        <td>{{ sim.seed }}</td>
      </tr>
    </tbody>
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres initiaux</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Poules</td>
        <td>{{ sim.initialHen }}</td>
      </tr>
      <tr>
        <td>Coqs</td>
        <td>{{ sim.initialRooster }}</td>
      </tr>
    </tbody>
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres limites</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Poules</td>
        <td>{{ sim.limitHen }}</td>
      </tr>
      <tr>
        <td>Coqs</td>
        <td>{{ sim.limitRooster }}</td>
      </tr>
      <tr>
        <td>Nids</td>
        <td>{{ sim.limitNest }}</td>
      </tr>
    </tbody>
  </table>

  <h4 class="mt-5 mb-0">Exécution</h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Indicateur</th>
        <th scope="col">Valeur</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Date d'exécution</td>
        <td>{{ sim.date|format_datetime('medium', 'medium') }}</td>
      </tr>
      <tr>
        <td>Temps d'exécution</td>
        <td>{{ mn.display_microseconds(sim.duration) }}</td>
      </tr>
      <tr>
        <td>Mémoire consommée</td>
        <td>{{ mn.display_memory(sim.memory) }}</td>
      </tr>
    </tbody>
  </table>

  <h4 class="mt-5 mb-0">Résultats</h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Temps</th>
        <th scope="col">Oeufs</th>
        <th scope="col">Poussins (M/F)</th>
        <th scope="col">Poules (F/V)</th>
        <th scope="col">Coqs</th>
        <th scope="col">Prod oeufs</th>
        <th scope="col">Prod viande</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      {% for bar in sim.bars %}
        <tr>
          <td>{{ mn.display_seconds(bar.time) }}</td>
          <td>{{ bar.livingEgg }}</td>
          <td>{{ bar.livingChickMale ~ ' / ' ~ bar.livingChickFemale }}</td>
          <td>{{ bar.livingHenFertilized ~ ' / ' ~ bar.livingHenVirgo }}</td>
          <td>{{ bar.livingRooster }}</td>
          <td>{{ bar.producedEgg }}</td>
          <td>{{ bar.producedMeat }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>

  {{ m.delete_button('delete-sim', 'Supprimer cette simulation') }}
  {{ m.delete_modale('delete-sim', path('necesse_sim_delete', { id: sim.id }), 'Attention, cela supprimera <strong>toutes les données</strong> de la simulation.') }}
{% endblock %}
