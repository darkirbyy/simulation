{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}
{% import 'necesse/macro.html.twig' as mn %}

{% set title = "Détails d'une simulation" %}

{% block main %}
  {{ m.backlink(path('necesse_sim_index')) }}

  {{ m.delete_button('delete-sim', 'Supprimer cette simulation') }}
  {{ m.delete_modale('delete-sim', path('necesse_sim_delete', { id: sim.id }), 'Attention, cela supprimera <strong>toutes les données</strong> de la simulation.') }}

  <div class="accordion">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          data-turbo="false"
          class="accordion-button fs-5 text-black"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#sim-accordion-parameter"
          aria-expanded="true"
          aria-controls="sim-accordion-parameter"
        >
          Paramètres
        </button>
      </h2>
      <div id="sim-accordion-parameter" class="accordion-collapse collapse show">
        <div class="accordion-body">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th class="fw-bold" colspan="2">Paramètres globaux</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              <tr>
                <td>Monde</td>
                <td>
                  <span class="me-3">{{ sim.world.label }}</span>
                  {# <a href="{{ path('necesse_world_show', { id: sim.world.id }) }}">Voir</a> #}
                  {{ m.show_button(path('necesse_world_show', { id: sim.world.id })) }}
                </td>
              </tr>
              <tr>
                <td>Temps</td>
                <td>{{ mn.display_seconds(sim.time) }}</td>
              </tr>
              <tr>
                <td>Graine</td>
                <td>{{ sim.seed }}</td>
              </tr>
            </tbody>
            <thead>
              <tr>
                <th class="fw-bold" colspan="2">Paramètres initiaux</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              <tr>
                <td>Poules</td>
                <td>{{ sim.initialHen }}</td>
              </tr>
              <tr>
                <td>Coqs</td>
                <td>{{ sim.initialRooster }}</td>
              </tr>
            </tbody>
            <thead>
              <tr>
                <th class="fw-bold" colspan="2">Paramètres limites</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              <tr>
                <td>Poules</td>
                <td>{{ sim.limitHen }}</td>
              </tr>
              <tr>
                <td>Coqs</td>
                <td>{{ sim.limitRooster }}</td>
              </tr>
              <tr>
                <td>Nids</td>
                <td>{{ sim.limitNest }}</td>
              </tr>
            </tbody>
          </table>
          {{ m.add_button(path('necesse_sim_new', { id: sim.id }), 'Lancer une nouvelle simulation avec les mêmes paramètres') }}
        </div>
      </div>
    </div>
  </div>

  <div class="accordion mt-3">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          data-turbo="false"
          class="accordion-button fs-5 text-black"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#sim-accordion-execution"
          aria-expanded="true"
          aria-controls="sim-accordion-execution"
        >
          Exécution
        </button>
      </h2>
      <div id="sim-accordion-execution" class="accordion-collapse collapse show">
        <div class="accordion-body">
          <table class="table table-striped table-hover">
            <thead>
              <tr>
                <th scope="col">Indicateur</th>
                <th scope="col">Valeur</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              <tr>
                <td>Date d'exécution</td>
                <td>{{ sim.date|format_datetime('medium', 'medium') }}</td>
              </tr>
              <tr>
                <td>Temps d'exécution</td>
                <td>{{ mn.display_microseconds(sim.duration) }}</td>
              </tr>
              <tr>
                <td>Mémoire consommée</td>
                <td>{{ mn.display_memory(sim.memory) }}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="accordion mt-3">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          data-turbo="false"
          class="accordion-button fs-5 text-black"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#sim-accordion-results"
          aria-expanded="true"
          aria-controls="sim-accordion-results"
        >
          Résultats complets
        </button>
      </h2>
      <div id="sim-accordion-results" class="accordion-collapse collapse show">
        <div class="accordion-body">
          <turbo-frame id="sim-turbo-results">
            <a href="{{ path('necesse_sim_results', { id: sim.id }) }}" class="my-2 btn btn-outline-secondary">Afficher les résultats</a>
          </turbo-frame>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
