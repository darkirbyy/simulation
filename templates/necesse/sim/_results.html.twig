{% import 'home/macro.html.twig' as m %}
{% import 'necesse/macro.html.twig' as mn %}

<turbo-frame id="sim-turbo-results">
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Temps</th>
        <th scope="col">Oeufs</th>
        <th scope="col">Poussins (M/F)</th>
        <th scope="col">Poules (F/V)</th>
        <th scope="col">Coqs</th>
        <th scope="col">Prod oeufs</th>
        <th scope="col">Prod viande</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      {% for bar in sim.bars %}
        <tr>
          <td>{{ mn.display_seconds(bar.time) }}</td>
          <td>{{ bar.livingEgg }}</td>
          <td>{{ bar.livingChickMale ~ ' / ' ~ bar.livingChickFemale }}</td>
          <td>{{ bar.livingHenFertilized ~ ' / ' ~ bar.livingHenVirgo }}</td>
          <td>{{ bar.livingRooster }}</td>
          <td>{{ bar.producedEgg }}</td>
          <td>{{ bar.producedMeat }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
</turbo-frame>
