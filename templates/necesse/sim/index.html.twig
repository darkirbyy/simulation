{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}
{% import 'necesse/macro.html.twig' as mn %}

{% set title = 'Gestions des simulations' %}

{% block main %}
  {{ m.backlink(path('necesse_index')) }}
  {{ m.add_button(path('necesse_sim_new'), 'Lancer une nouvelle simulation') }}

  {# Table displaying all objects #}
  <table class="mt-2 table table-striped table-hover">
    {# Table header #}
    <thead>
      <tr>
        <th class="align-center" scope="col">Monde</th>
        <th class="align-center" scope="col">Date</th>
        <th class="align-center" scope="col">Temps d'exécution</th>
        <th class="align-center" scope="col">Mémoire consommée</th>
        <th class="align-center" scope="col">Nombre d'itérations</th>
        <th class="w-1 text-nowrap text-end align-center" scope="col">Actions</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      {% for sim in sims %}
        <tr>
          <td class="py-2">{{ sim.world.label }}</td>
          <td class="py-2">{{ sim.date|format_datetime('medium', 'medium') }}</td>
          <td class="py-2">{{ mn.display_microseconds(sim.duration) }}</td>
          <td class="py-2">{{ mn.display_memory(sim.memory) }}</td>
          <td class="py-2">{{ sim.iteration }}</td>
          <td class="w-1 text-nowrap text-end py-1 align-center">{{ m.show_button(path('necesse_sim_show', { id: sim.id })) }}</td>
        </tr>
      {% endfor %}
    </tbody>
  </table>
{% endblock %}
