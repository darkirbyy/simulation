{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}
{% from 'necesse/macro.html.twig' import display_seconds %}

{% set title = "Détails d'une simulation" %}

{% block main %}
  {{ m.backlink(path('necesse_run_index')) }}

  <h4 class="mt-2 mb-0">Paramètres</h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres globaux</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Monde</td>
        <td>
          {{ run.world.label }}
          {{ m.show_button(path('necesse_world_show', { id: run.world.id })) }}
        </td>
      </tr>
      <tr>
        <td>Temps</td>
        <td>{{ display_seconds(run.time) }}</td>
      </tr>
      <tr>
        <td>Graine</td>
        <td>{{ run.seed }}</td>
      </tr>
    </tbody>
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres initiaux</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Poules</td>
        <td>{{ run.initialHen }}</td>
      </tr>
      <tr>
        <td>Coqs</td>
        <td>{{ run.initialRooster }}</td>
      </tr>
    </tbody>
    <thead>
      <tr>
        <th class="fw-bold" colspan="2">Paramètres limites</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Poules</td>
        <td>{{ run.limitHen }}</td>
      </tr>
      <tr>
        <td>Coqs</td>
        <td>{{ run.limitRooster }}</td>
      </tr>
      <tr>
        <td>Nids</td>
        <td>{{ run.limitNest }}</td>
      </tr>
    </tbody>
  </table>

  <h4 class="mt-5 mb-0">Exécution</h4>
  <table class="table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col" colspan="2">Indicateur</th>
        <th scope="col" colspan="2">Valeur</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Date d'exécution</td>
        <td>{{ run.date|format_datetime('medium', 'medium') }}</td>
      </tr>
      <tr>
        <td>Temps d'exécution</td>
        <td>{{ display_seconds(run.duration) }}</td>
      </tr>
    </tbody>
  </table>

  <h4 class="mt-5 mb-0">Résultats</h4>

  {{ m.delete_button('delete-run', 'Supprimer cette simulation') }}
  {{ m.delete_modale('delete-run', path('necesse_run_delete', { id: run.id }), 'Attention, cela supprimera <strong> toutes les données</strong> de la simulation.') }}
{% endblock %}
