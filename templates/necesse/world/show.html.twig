{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}

{% macro display_minutes(minutes) %}
  {{- ((minutes / 60)|round(0, 'floor')) ~ 'min ' ~ minutes % 60 ~ 's' -}}
{% endmacro %}

{% set title = "Détails d'un monde" %}

{% block main %}
  {{ m.backlink(path('necesse_world_index')) }}

  <table class="mt-2 table table-striped table-hover">
    <thead>
      <tr>
        <th scope="col">Paramètre</th>
        <th scope="col" colspan="2">Valeur / Intervalle</th>
      </tr>
    </thead>
    <tbody class="table-group-divider">
      <tr>
        <td>Libellé</td>
        <td colspan="2">{{ world.label }}</td>
      </tr>
      <tr>
        <td>Temps pour qu'un oeuf se transforme en poussin</td>
        <td>{{ _self.display_minutes(world.eggToChick.min) }}</td>
        <td>{{ _self.display_minutes(world.eggToChick.max) }}</td>
      </tr>
      <tr>
        <td>Temps pour qu'un poussin se transforme en poulet</td>
        <td>{{ _self.display_minutes(world.chickToChicken.min) }}</td>
        <td>{{ _self.display_minutes(world.chickToChicken.max) }}</td>
      </tr>
      <tr>
        <td>Temps pour qu'une poule ponde un oeuf</td>
        <td>{{ _self.display_minutes(world.henToLay.min) }}</td>
        <td>{{ _self.display_minutes(world.henToLay.max) }}</td>
      </tr>
      <tr>
        <td>Temps pour qu'un coq fertilise une poule</td>
        <td>{{ _self.display_minutes(world.roosterToFertilize.min) }}</td>
        <td>{{ _self.display_minutes(world.roosterToFertilize.max) }}</td>
      </tr>
      <tr>
        <td>Probabilité qu'un oeuf donne une femelle</td>
        <td colspan="2">{{ world.eggToFemale * 100 }}%</td>
      </tr>
      <tr>
        <td>Mode de remplacement quand un coq/une poule doit être tué(e)</td>
        <td colspan="2">{{ world.replaceMode|trans }}</td>
      </tr>
    </tbody>
  </table>
{% endblock %}
