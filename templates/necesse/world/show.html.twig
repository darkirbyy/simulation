{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}
{% import 'necesse/macro.html.twig' as mn %}

{% set title = "Détails d'un monde" %}

{% block main %}
  {{ m.backlink(path('necesse_world_index')) }}
  {{ m.delete_button('delete-world', 'Supprimer ce monde') }}
  {{
    m.delete_modale(
      'delete-world',
      path('necesse_world_delete', { id: world.id }),
      'Attention, cela supprimera ce monde et <strong>toutes les simulations</strong> réalisées dedans.'
    )
  }}

  <div class="accordion">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          data-turbo="false"
          class="accordion-button fs-5 text-black"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#world-accordion-parameter"
          aria-expanded="true"
          aria-controls="world-accordion-parameter"
        >
          Paramètres
        </button>
      </h2>
      <div id="world-accordion-parameter" class="accordion-collapse collapse show">
        <div class="accordion-body">
          <table class="mt-2 table table-striped table-hover">
            <thead>
              <tr>
                <th scope="col">Nom</th>
                <th scope="col" colspan="2">Valeur / Intervalle</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              <tr>
                <td>Libellé</td>
                <td colspan="2">{{ world.label }}</td>
              </tr>
              <tr>
                <td>Temps pour qu'un oeuf se transforme en poussin</td>
                <td>{{ mn.display_seconds(world.eggToChick.min) }}</td>
                <td>{{ mn.display_seconds(world.eggToChick.max) }}</td>
              </tr>
              <tr>
                <td>Temps pour qu'un poussin se transforme en poulet</td>
                <td>{{ mn.display_seconds(world.chickToChicken.min) }}</td>
                <td>{{ mn.display_seconds(world.chickToChicken.max) }}</td>
              </tr>
              <tr>
                <td>Temps pour qu'une poule ponde un oeuf</td>
                <td>{{ mn.display_seconds(world.henToLay.min) }}</td>
                <td>{{ mn.display_seconds(world.henToLay.max) }}</td>
              </tr>
              <tr>
                <td>Temps pour qu'un coq fertilise une poule</td>
                <td>{{ mn.display_seconds(world.roosterToFertilize.min) }}</td>
                <td>{{ mn.display_seconds(world.roosterToFertilize.max) }}</td>
              </tr>
              <tr>
                <td>Probabilité qu'un oeuf donne une femelle</td>
                <td colspan="2">{{ world.eggToFemale * 100 }}%</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <div class="accordion mt-3">
    <div class="accordion-item">
      <h2 class="accordion-header">
        <button
          data-turbo="false"
          class="accordion-button fs-5 text-black"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#world-accordion-sims"
          aria-expanded="true"
          aria-controls="world-accordion-sims"
        >
          Simulations
        </button>
      </h2>
      <div id="world-accordion-sims" class="accordion-collapse collapse show">
        <div class="accordion-body">
          <table class="mt-2 table table-striped table-hover">
            <thead>
              <tr>
                <th class="align-center" scope="col">Algorithme</th>
                <th class="align-center" scope="col">Date</th>
                <th class="align-center" scope="col">Temps d'exécution</th>
                <th class="align-center" scope="col">Mémoire consommée</th>
                <th class="align-center" scope="col">Nombre d'itérations</th>
                <th class="w-1 text-nowrap text-end align-center" scope="col">Actions</th>
              </tr>
            </thead>
            <tbody class="table-group-divider">
              {% for sim in world.sims %}
                <tr>
                  <td>{{ sim.run|trans }}</td>
                  <td>{{ sim.date|format_datetime('medium', 'medium') }}</td>
                  <td>{{ mn.display_microseconds(sim.duration) }}</td>
                  <td>{{ mn.display_memory(sim.memory) }}</td>
                  <td class="py-2">{{ sim.iteration }}</td>

                  <td class="w-1 text-nowrap text-end py-1 align-center">{{ m.show_button(path('necesse_sim_show', { id: sim.id })) }}</td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
{% endblock %}
