{% extends 'base.html.twig' %}
{% import 'home/macro.html.twig' as m %}

{% set title = "Ajout d'un monde" %}

{% block main %}
  {{ m.backlink(path('necesse_world_index')) }}
  {{ form_start(form) }}
  <h5 class="mb-1">Général</h5>
  {{ form_row(form.label) }}
  <h5 class="mb-1">Intervalle de temps</h5>
  {{ form_row(form.eggToChick) }}
  {{ form_row(form.chickToChicken) }}
  {{ form_row(form.henToLay) }}
  {{ form_row(form.roosterToFertilize) }}
  <h5 class="mb-1">Autre</h5>
  {{ form_row(form.eggToFemale) }}
  {{ form_row(form.replaceMode) }}
  {{ form_end(form) }}
{% endblock %}
