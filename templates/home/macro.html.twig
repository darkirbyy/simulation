{% macro backlink(path) %}
  <div class="mb-2">
    <a class="link-secondary icon-link icon-link-hover icon-link-left" href="{{ path }}">
      <span class="bi bi-arrow-left mb-1"></span>
      Retour
    </a>
  </div>
{% endmacro %}

{% macro add_button(path, text) %}
  <div class="mb-2 text-end">
    <a class="btn btn-primary" href="{{ path }}">
      <span class="bi bi-plus-square-fill me-md-1"></span>
      {{ text|default('Ajouter') }}
    </a>
  </div>
{% endmacro %}

{% macro show_button(path, text) %}
  <a href="{{ path }}" class="btn btn-sm btn-outline-secondary">
    <span class="bi bi-eye"></span>
    {{ text|default('Voir') }}
  </a>
{% endmacro %}

{% macro delete_button(id, text) %}
  <div class="mb-2 text-end">
    <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal" data-bs-target="#{{ id }}-modale">
      <span class="bi bi-trash-fill me-1"></span>
      {{ text|default('Supprimer') }}
    </button>
  </div>
{% endmacro %}

{% macro delete_modale(id, path, body) %}
  <div class="modal fade" id="{{ id }}-modale" tabindex="-1" role="dialog" loading="lazy">
    <div class="modal-dialog modal-dialog-centered">
      <div class="modal-content">
        <div class="modal-header">
          <h1 class="modal-title fs-5">Confirmer la suppression</h1>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
          {{ body|raw }}
        </div>

        <div class="modal-footer">
          <form action="{{ path }}" method="post">
            <button type="submit" class="btn btn-danger">
              <span class="bi bi-trash-fill me-1"></span>
              Supprimer
            </button>
            <input type="hidden" name="_token" data-controller="csrf-protection" value="{{ csrf_token('simulation/delete') }}" />
          </form>
        </div>
      </div>
    </div>
  </div>
{% endmacro %}
