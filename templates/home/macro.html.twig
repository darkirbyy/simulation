{# Macro to create a backlink #}
{% macro backlink(path) %}
  <div class="mb-2">
    <a class="link-secondary icon-link icon-link-hover icon-link-left" href="{{ path }}">
      <span class="bi bi-arrow-left mb-1" aria-hidden="true"></span>
      Retour
    </a>
  </div>
{% endmacro %}

{# Macro to create a backlink #}
{% macro add_button(path, text) %}
  <div class="mb-2">
    <a class="btn btn-primary" href="{{ path }}">
      <span class="bi bi-plus-square-fill me-md-1" aria-hidden="true"></span>
      {{ text|default('Ajouter') }}
    </a>
  </div>
{% endmacro %}
